# ================================
# oAIsis - API CONFIGURATION
# ================================

# Google Gemini API (fallback when Vertex is unavailable)
GEMINI_API_KEY=your_google_gemini_key

# Google Cloud / Vertex AI
GOOGLE_PROJECT_ID=your_gcp_project_id
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_GEMINI_MODEL=gemini-2.0-flash-exp
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Service-account credentials (choose either inline JSON or file path)
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Qdrant Vector Database (WORKING!)
QDRANT_URL=https://your-qdrant-endpoint
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=oAIsis
QDRANT_VECTOR_SIZE=384

# Opus Workflow
OPUS_API_URL=https://opus.example.com/api/logs
OPUS_WORKFLOW_ID=your_opus_workflow_id
OPUS_API_KEY=your_opus_token

# App Settings
ANALYSIS_INTERVAL_SECONDS=2
ENABLE_MEMORY=true
GUIDELY_STUN_URLS=stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
GUIDELY_DISABLE_STUN=false
GUIDELY_TURN_URL=turn:oaisis.metered.live:80?transport=tcp
GUIDELY_TURN_URLS=turn:oaisis.metered.live:80?transport=tcp,turn:oaisis.metered.live:443?transport=tcp,turns:oaisis.metered.live:443?transport=tcp
GUIDELY_TURN_USERNAME=openrelayproject
GUIDELY_TURN_PASSWORD=6gR6zT11Irmt6-qJjD-N1vDcrLtiwycymd2Sh9edVGw9vbGr
GUIDELY_FORCE_TURN=false

# Text-to-Speech (Edge first, Google fallback)
GUIDELY_TTS_PROVIDER=edge
EDGE_TTS_RATE=-10%
EDGE_TTS_VOICE_EN=en-US-AriaNeural
EDGE_TTS_VOICE_AR=ar-SA-ZariyahNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural

# Optional Google overrides
GOOGLE_TTS_VOICE_OVERRIDE=
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_AUDIO_ENCODING=MP3

# Embeddings (sentence-transformers first, Gemini fallback)
GUIDELY_EMBEDDING_PROVIDER=local-first
GUIDELY_LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GUIDELY_LOCAL_EMBED_DEVICE=cpu
